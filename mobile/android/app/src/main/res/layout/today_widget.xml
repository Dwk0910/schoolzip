<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_card"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="13dp" android:paddingVertical="10dp"
    android:background="@drawable/today_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widget_school" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
            android:ellipsize="end" android:includeFontPadding="false" android:text="오늘 과목"
            android:textColor="#232531" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_class" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:includeFontPadding="false" android:textColor="#575963" android:textSize="12sp"/>
    </LinearLayout>

    <TextView android:id="@+id/day_stamp" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:includeFontPadding="false" android:textColor="#666875" android:textSize="11sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="6dp" android:background="#E6E6EB" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/subjects" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:textColor="#545265" android:textSize="14sp"/>
    <LinearLayout android:id="@+id/lesson_grid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="3dp"/>
</LinearLayout>
